{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Linotes main window. The webview may only listen to events, write log lines, and call Linotes' own commands; it has no direct filesystem, shell, dialog, opener or network access.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "log:allow-log",
    "allow-list-notes",
    "allow-read-note",
    "allow-create-note",
    "allow-save-note",
    "allow-set-favorite",
    "allow-move-note",
    "allow-trash-note",
    "allow-restore-note",
    "allow-delete-note-permanently",
    "allow-empty-trash",
    "allow-list-folders",
    "allow-create-folder",
    "allow-rename-folder",
    "allow-delete-folder",
    "allow-save-image",
    "allow-choose-image",
    "allow-add-dropped-files",
    "allow-paste-files",
    "allow-open-linked-file",
    "allow-search-notes",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-library-status",
    "allow-choose-notes-directory",
    "allow-use-default-notes-directory",
    "allow-retry-open-library",
    "allow-open-notes-folder",
    "allow-reveal-note-file",
    "allow-rebuild-index",
    "allow-import-files",
    "allow-import-folder",
    "allow-export-note",
    "allow-export-zip",
    "allow-app-ready",
    "allow-get-app-info",
    "allow-open-external-url",
    "allow-apply-window-theme",
    "allow-confirm-close",
    "allow-cancel-close"
  ]
}
