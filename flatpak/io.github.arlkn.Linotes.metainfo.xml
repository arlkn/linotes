<component type="desktop-application">
  <id>io.github.arlkn.Linotes</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Linotes</name>
  <summary>Local-first Markdown notes</summary>
  <developer id="io.github.arlkn">
    <name>Aral Alkan and Linotes contributors</name>
  </developer>
  <description>
    <p>
      Linotes is a fast, private notes app. Your notes are plain Markdown files in a folder you
      choose — no account, no cloud, no telemetry.
    </p>
    <ul>
      <li>Rich text editing with checklists, code blocks and links, or plain Markdown</li>
      <li>Folders, favorites, recently edited notes and a Trash with restore</li>
      <li>Instant full-text search</li>
      <li>Changes made by other apps and sync tools appear live, without overwriting your work</li>
      <li>Import and export Markdown, or back up by copying a folder</li>
      <li>Light and dark styles and full keyboard control</li>
    </ul>
  </description>
